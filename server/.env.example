PORT=5000
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb://localhost:27017/leavemgmt
JWT_SECRET=your_jwt_secret_key_here

# Google Gemini AI Configuration
# Get your API key from https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model ID (e.g. gemini-2.5-flash or current Flash ID from AI Studio)
GEMINI_MODEL=

# Optional fallback Gemini Model ID (tried once if main model fails with 503 after 1 retry)
GEMINI_FALLBACK_MODEL=

# Total AI request deadline in milliseconds across all retries and fallback attempts (defaults to 25000)
GEMINI_REQUEST_TIMEOUT_MS=25000

# Per-user daily cap for Gemini AI fallback calls (defaults to 50)
GEMINI_DAILY_LIMIT_PER_USER=50

# Per-user hourly cap for PDF report generation (defaults to 20)
PDF_LIMIT_PER_HOUR=20


